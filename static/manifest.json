{
  "manifest_version": 3,
  "name": "Doze",
  "version": "0.3.0",
  "description": "Puts the tabs you aren't using to sleep so Chrome can free their memory.",
  "minimum_chrome_version": "121",
  "permissions": ["tabs", "storage", "alarms", "contextMenus", "favicon", "system.memory", "system.cpu", "scripting", "sidePanel"],
  "optional_host_permissions": ["<all_urls>"],
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Doze",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "sleep-selected": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Sleep the selected tabs"
    },
    "sleep-others": {
      "suggested_key": { "default": "Alt+Shift+O" },
      "description": "Sleep every other tab in this window"
    },
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+D" }
    }
  }
}
